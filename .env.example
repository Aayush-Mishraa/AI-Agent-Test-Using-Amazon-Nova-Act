# Nova Act Authentication
# Option 1 (Recommended for local dev): API Key from https://nova.amazon.com/act
NOVA_ACT_API_KEY=your_nova_act_api_key_here

# Option 2: AWS IAM credentials (needed for Workflow / cloud deployment features)
# Configure via: aws configure  OR  set these manually
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_DEFAULT_REGION=us-east-1
